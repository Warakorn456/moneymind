rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }

    // uid ที่ผูกกับ username นี้ใน members (คืน '' ถ้าไม่มี doc หรือไม่มี field uid)
    function linkedUid(userId) {
      return (exists(/databases/$(database)/documents/members/$(userId))
              && ('uid' in get(/databases/$(database)/documents/members/$(userId)).data))
        ? get(/databases/$(database)/documents/members/$(userId)).data.uid
        : '';
    }

    // ผู้ใช้ที่ login แล้วและเป็นเจ้าของบัญชีนี้จริง (uid ตรงกับที่ผูกไว้)
    function ownsAccount(userId) {
      return authed() && linkedUid(userId) != '' && linkedUid(userId) == request.auth.uid;
    }

    // บัญชี legacy/ใหม่ที่ยังไม่ผูก uid → ให้ผู้ใช้ที่ login แล้ว claim ได้ครั้งแรก
    function unclaimed(userId) {
      return authed() && linkedUid(userId) == '';
    }

    // ── ข้อมูลการเงินรายคน (1 doc ต่อ 1 user, key = username) ──
    match /userdata/{userId} {
      // ทุกคน (รวม warakorn): เฉพาะ Firebase user ที่ผูกบัญชีนี้เท่านั้น
      // GCP/Telegram/Gmail scripts ใช้ SA token (roles/datastore.user) บายพาส rules
      allow read, write: if ownsAccount(userId);
    }

    // ── โปรไฟล์ / mapping username↔uid (ไม่มีข้อมูลการเงิน) ──
    match /members/{userId} {
      // login ต้อง lookup username จาก email; admin (เจ้าของ ไม่ auth) list members
      allow read: if true;
      // เขียน: เจ้าของ doc, หรือ claim บัญชีที่ยังไม่ผูก uid
      // (เดิมมี exception `userId == 'warakorn'` ให้เขียนได้แบบไม่ต้อง auth เลย — เป็นช่องโหว่ให้ session/อุปกรณ์
      // ไหนก็ได้ (หรือแม้แต่ผู้ไม่ auth) แย่งชิง uid ของ owner ได้ ตัดออกแล้ว ไม่มี code path ใดพึ่งพา exception นี้)
      allow write: if ownsAccount(userId) || unclaimed(userId);
    }

    // ── Gmail bank-alert (multi-user, เพิ่ม 2026-08-22) ──
    // gmailAuth เก็บ Gmail OAuth refresh_token/access_token ต่อ user — ห้าม client อ่าน/เขียนเด็ดขาด
    // ไม่ใช่แบบ lineUserId (แค่ id อ้างอิง ไม่ sensitive) — token นี้เทียบเท่ารหัสผ่านชั่วคราวเข้าอีเมลจริง
    // เข้าถึงได้ทางเดียวคือ SA token ฝั่ง server (ai_proxy.py / gmail_bank_alert_multiuser.py) บายพาส rules
    match /gmailAuth/{userId} {
      allow read, write: if false;
    }
    // gmailPending เก็บธุรกรรมที่ตรวจพบแล้วรอผู้ใช้กดยืนยัน/ข้ามผ่าน LINE — เขียน/ลบโดย server เท่านั้น
    match /gmailPending/{userId} {
      allow read, write: if false;
    }
    // gmailImportState เก็บ dedup state (message id ที่เคยประมวลผลแล้ว) ต่อ user — server เท่านั้น
    match /gmailImportState/{userId} {
      allow read, write: if false;
    }

    // ── สรุป usage หลังบ้าน (เขียนโดย admin_stats.py ผ่าน SA เท่านั้น) ──
    // owner (warakorn) อ่านได้คนเดียว; client เขียนไม่ได้ (SA token บายพาส rules)
    match /admin/{doc} {
      allow read: if ownsAccount('warakorn');
      allow write: if false;
    }

    // ── Snapshot รายวันของ Net Worth รวม (เขียนโดย admin_stats.py ผ่าน SA) — ใช้ทำกราฟเทรนด์ในหน้า Admin ──
    match /adminHistory/{doc} {
      allow read: if ownsAccount('warakorn');
      allow write: if false;
    }

    // ── Feedback + client error reports (สร้างได้อย่างเดียว อ่านคืนไม่ได้จาก client) ──
    // แทนที่การส่ง Telegram ตรงจาก client ด้วย hardcode bot token (เดิม view-source เห็น token ได้)
    // สคริปต์ฝั่ง VM (auth ผ่าน SA) เป็นคนอ่าน collection นี้แล้วส่งต่อ Telegram แทน
    match /reports/{doc} {
      allow create: if authed();
      allow read, update, delete: if false;
    }

    // ── ทดสอบการเชื่อมต่อ ──
    match /_ping/{doc} {
      allow read, write: if true;
    }

    // ปฏิเสธทุกอย่างที่เหลือโดยปริยาย
  }
}
