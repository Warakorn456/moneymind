{
  "expo": {
    "name": "MoneyMind",
    "slug": "moneymind",
    "scheme": "moneymind",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.moneymind.th",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "MoneyMind ใช้กล้องเพื่อถ่ายรูปโปรไฟล์ และสแกนใบเสร็จ/สลิป/เอกสารภาษีด้วย AI",
        "NSPhotoLibraryUsageDescription": "MoneyMind ขอเข้าถึงคลังรูปภาพเพื่อเลือกรูปโปรไฟล์ และเลือกรูปใบเสร็จ/สลิป/เอกสารสำหรับสแกนด้วย AI",
        "NSPhotoLibraryAddUsageDescription": "MoneyMind ขอบันทึกรูปภาพ/ไฟล์ที่ส่งออก (เช่น รายงาน) ลงในคลังรูปภาพของคุณ"
      }
    },
    "android": {
      "package": "app.moneymind.th",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f292a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "7575ae4b-4dc3-4412-9ffa-f6e98893371c"
      }
    },
    "owner": "warakorn456",
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#7c3aed"
        }
      ],
      "./withPodfileModularHeaders"
    ]
  }
}
